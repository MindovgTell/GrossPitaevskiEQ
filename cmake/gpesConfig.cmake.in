@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(_gpes_saved_module_path "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(GPESEigen3 MODULE)
find_dependency(GPESFFTW MODULE)
find_dependency(Threads)
set(CMAKE_MODULE_PATH "${_gpes_saved_module_path}")
unset(_gpes_saved_module_path)

if(NOT @GPES_BUNDLED_SPDLOG@)
  if(NOT TARGET "@GPES_EXTERNAL_SPDLOG_TARGET@")
    find_dependency(spdlog CONFIG)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/gpesTargets.cmake")
set(gpes_core_FOUND TRUE)
set(gpes_plot_FOUND FALSE)
foreach(_gpes_component IN LISTS gpes_FIND_COMPONENTS)
  if(_gpes_component STREQUAL "plot" AND @GPES_ENABLE_PLOTTING@)
    find_dependency(Python3 COMPONENTS Interpreter Development NumPy)
    include("${CMAKE_CURRENT_LIST_DIR}/gpesPlotTargets.cmake")
    set(gpes_plot_FOUND TRUE)
  elseif(NOT _gpes_component STREQUAL "core")
    set(gpes_${_gpes_component}_FOUND FALSE)
    set(gpes_NOT_FOUND_MESSAGE "Requested GPES component '${_gpes_component}' is unavailable.")
  endif()
endforeach()
check_required_components(gpes)
