cmake_minimum_required(VERSION 3.24)

string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef suffix)
set(root "${TEST_ROOT}/${suffix}")
file(MAKE_DIRECTORY "${root}")

function(run expected)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "Command ${ARGN}\nExpected ${expected}, got ${result}\n${out}\n${err}")
  endif()
endfunction()

function(require_file path)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Missing expected output: ${path}")
  endif()
endfunction()

function(require_text path pattern)
  file(READ "${path}" contents)
  if(NOT contents MATCHES "${pattern}")
    message(FATAL_ERROR "Expected ${pattern} in ${path}:\n${contents}")
  endif()
endfunction()

run(0 "${GROUNDSTATE}" --help)
run(0 "${BDG}" --help)
set(ground_args --nx 16 --ny 16 --x-half-length 6 --y-half-length 6
  --a-s 0.001 --a-dd 0 --num-particles 1 --w-x 1 --w-y 1 --w-z 8
  --dt 0.01 --min-ground-dt 0.0001 --seed-noise 0
  --convergence-check-interval 20 --snapshot-interval 100)
run(0 "${GROUNDSTATE}" ${ground_args} --max-ground-steps 10000 --output-dir "${root}/ground")
require_file("${root}/ground/COMPLETED")
require_file("${root}/ground/images/ground_state_density.bmp")
require_file("${root}/ground/images/energy_history.svg")
require_text("${root}/ground/ground_state.txt" "ground_state_converged=true")
require_text("${root}/ground/ground_state.txt" "absolute_energy_tolerance=")
file(SHA256 "${root}/ground/wavefunction/wavefunction.csv" original_hash)
set(bdg_args --modes 2 --ncv 12 --shift 1.1 --dense-max-dim 512 --tol 1e-9)
run(0 "${BDG}" --input-dir "${root}/ground" ${bdg_args} --output-dir "${root}/bdg")
require_file("${root}/bdg/COMPLETED")
require_file("${root}/bdg/spectrum.csv")
require_file("${root}/bdg/excited_states/mode_0000.csv")
require_file("${root}/bdg/images/bdg_spectrum.svg")
require_file("${root}/bdg/images/bdg_modes/mode_0000.bmp")
require_text("${root}/bdg/bdg_status.txt" "bdg_attempted=true")
require_text("${root}/bdg/bdg_status.txt" "status=complete")
file(SHA256 "${root}/ground/wavefunction/wavefunction.csv" after_hash)
if(NOT original_hash STREQUAL after_hash)
  message(FATAL_ERROR "BdG modified the input wavefunction")
endif()

# Existing destinations are never reused, even for identical command lines.
run(1 "${GROUNDSTATE}" ${ground_args} --output-dir "${root}/ground")
run(1 "${BDG}" --input-dir "${root}/ground" ${bdg_args} --output-dir "${root}/bdg")
run(0 "${BDG}" --input-dir "${root}/ground" ${bdg_args} --no-mode-fields --output-dir "${root}/retry")
require_file("${root}/retry/images/bdg_modes/mode_0000.bmp")
if(EXISTS "${root}/retry/excited_states/mode_0000.csv")
  message(FATAL_ERROR "--no-mode-fields was ignored")
endif()
run(0 "${GROUNDSTATE}" --resume "${root}/ground" --max-ground-steps 10000 --output-dir "${root}/resumed")
file(SHA256 "${root}/ground/wavefunction/wavefunction.csv" resumed_hash)
if(NOT original_hash STREQUAL resumed_hash)
  message(FATAL_ERROR "Restart modified its source checkpoint")
endif()

# An interrupted run must still have final diagnostics, and is not accepted for BdG.
run(2 "${GROUNDSTATE}" ${ground_args} --max-ground-steps 1 --output-dir "${root}/short")
require_text("${root}/short/ground_state.txt" "steps_completed=1")
require_text("${root}/short/wavefunction/energy_history.csv" "step,energy\n1,")
run(1 "${BDG}" --input-dir "${root}/short" ${bdg_args} --output-dir "${root}/rejected")
require_text("${root}/rejected/bdg_status.txt" "bdg_attempted=false")
require_file("${root}/rejected/FAILED")
run(2 "${BDG}" --input-dir "${root}/short" ${bdg_args} --allow-unconverged --output-dir "${root}/diagnostic")
require_text("${root}/diagnostic/bdg_status.txt" "status=diagnostic_only")

# Force an Arnoldi budget failure; retain a CSV and diagnostics even with zero modes.
run(2 "${BDG}" --input-dir "${root}/ground" --modes 4 --ncv 9 --shift 0.05
  --dense-max-dim 512 --tol 1e-14 --max-iter 1 --output-dir "${root}/partial")
require_file("${root}/partial/spectrum.csv")
require_file("${root}/partial/INCOMPLETE")
require_text("${root}/partial/bdg_status.txt" "bdg_attempted=true")
if(EXISTS "${root}/partial/COMPLETED")
  message(FATAL_ERROR "An incomplete spectrum was marked complete")
endif()

# Metadata/CSV disagreements cannot silently change the Hamiltonian or grid.
file(COPY "${root}/ground/wavefunction" DESTINATION "${root}/wrong-grid")
file(READ "${root}/wrong-grid/wavefunction/parameters.txt" manifest)
string(REPLACE "x_half_length=6" "x_half_length=7" manifest "${manifest}")
file(WRITE "${root}/wrong-grid/wavefunction/parameters.txt" "${manifest}")
run(1 "${BDG}" --input-dir "${root}/wrong-grid" ${bdg_args} --output-dir "${root}/wrong-grid-result")
require_text("${root}/wrong-grid-result/FAILED" "coordinates do not match")
file(COPY "${root}/ground/wavefunction" DESTINATION "${root}/missing-key")
string(REGEX REPLACE "omega_z=[^\n]*\n" "" manifest "${manifest}")
file(WRITE "${root}/missing-key/wavefunction/parameters.txt" "${manifest}")
run(1 "${BDG}" --input-dir "${root}/missing-key" ${bdg_args} --output-dir "${root}/missing-key-result")
require_text("${root}/missing-key-result/FAILED" "omega_z")

# A failed state must not prevent later states in a sweep from being processed.
file(COPY "${root}/short/wavefunction" DESTINATION "${root}/batch/01_bad")
file(COPY "${root}/ground/wavefunction" DESTINATION "${root}/batch/02_good")
run(1 "${BDG}" --input-dir "${root}/batch" --recursive ${bdg_args} --output-dir "${root}/batch-result")
require_file("${root}/batch-result/state_0002/COMPLETED")
require_text("${root}/batch-result/batch_status.txt" "total=2\ncompleted=1")
message(STATUS "Split workflow passed: ${root}")
